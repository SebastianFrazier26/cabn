# Template for the hosted demo's static server (apps/demo/Dockerfile).
# scripts/render-caddyfile.mjs fills the Content-Security-Policy value with
# DEMO_CSP_HEADER from csp-policy.mjs at image build time, so the policy has
# one source.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		Content-Security-Policy "__CABN_DEMO_CSP__"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Vite's content-hashed chunks sit directly in /assets/. The sprites copied
	# from public/assets/ live in its subdirectories under fixed names, so they
	# (and index.html, worlds/, everything else) revalidate instead.
	@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|mjs|css)$
	@unhashed not path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|mjs|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "no-cache"

	file_server
}
