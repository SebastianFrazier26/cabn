# apps/backend — see README's "Backend API" section for what each var does.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=http://localhost:5173
# Comma-separated SHA-256 hex hashes of valid API keys — never plaintext keys.
# Generate one with `pnpm -F @cabn/backend keygen`. Required in production;
# left empty here, the upload route just answers 503 instead of being open.
CABN_API_KEY_SHA256=
# How many reverse proxies sit in front of the app and append to
# X-Forwarded-For (0-10). 0 locally; 1 on Railway. Rate-limit and CORS both
# key off request.ip, which is the entry the outermost trusted proxy added.
CABN_TRUST_PROXY=0
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
