{
	"name": "@cabn/converter",
	"version": "0.1.0",
	"description": "Converts a directory or zipfile into a validated cabn world bundle: walk, classify, layout, cluster/annex split, search index, and error annotation into monsters.",
	"keywords": [
		"cabn",
		"converter",
		"zip"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SebastianFrazier26/cabn.git",
		"directory": "packages/converter"
	},
	"homepage": "https://github.com/SebastianFrazier26/cabn/tree/main/packages/converter#readme",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"default": "./dist/browser.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@cabn/world-schema": "workspace:*",
		"fflate": "^0.8.3",
		"minisearch": "7.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.4"
	}
}
