{
	"name": "@cabn/engine",
	"version": "0.1.0",
	"description": "Phaser 3 + zustand + mitt game engine that renders a cabn world bundle as a walkable game, with a React bridge (CabnGame) and HUD components.",
	"keywords": [
		"cabn",
		"phaser",
		"game-engine"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SebastianFrazier26/cabn.git",
		"directory": "packages/engine"
	},
	"homepage": "https://github.com/SebastianFrazier26/cabn/tree/main/packages/engine#readme",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./local-exec": {
			"types": "./dist/local-exec.d.ts",
			"default": "./dist/local-exec.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"third-party-licenses"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@cabn/converter": "workspace:*",
		"@cabn/world-schema": "workspace:*",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@lezer/highlight": "1.2.3",
		"minisearch": "7.2.0",
		"mitt": "^3.0.1",
		"phaser": "^3.90.0",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}
