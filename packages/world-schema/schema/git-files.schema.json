{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"gitVersion": {
			"type": "number",
			"const": 1
		},
		"files": {
			"maxItems": 16,
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^(HEAD|config|packed-refs|shallow|objects\\/pack\\/pack-[0-9a-f]{40}\\.(pack|idx))$"
			}
		}
	},
	"required": ["gitVersion", "files"],
	"additionalProperties": false
}
