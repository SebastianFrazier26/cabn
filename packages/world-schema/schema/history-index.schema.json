{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"historyVersion": {
			"type": "number",
			"const": 1
		},
		"head": {
			"type": "object",
			"properties": {
				"branch": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 255
						},
						{
							"type": "null"
						}
					]
				},
				"oid": {
					"type": "string",
					"pattern": "^[0-9a-f]{40}$"
				}
			},
			"required": ["branch", "oid"],
			"additionalProperties": false
		},
		"commits": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"oid": {
						"type": "string",
						"pattern": "^[0-9a-f]{40}$"
					},
					"parents": {
						"maxItems": 16,
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[0-9a-f]{40}$"
						}
					},
					"author": {
						"type": "string",
						"maxLength": 200
					},
					"time": {
						"type": "integer",
						"minimum": -9007199254740991,
						"maximum": 9007199254740991
					},
					"message": {
						"type": "string",
						"maxLength": 4000
					},
					"messageWithheld": {
						"type": "boolean",
						"const": true
					},
					"changes": {
						"maxItems": 300,
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"path": {
									"type": "string",
									"minLength": 1,
									"maxLength": 1024
								},
								"status": {
									"type": "string",
									"enum": ["added", "modified", "deleted"]
								},
								"additions": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								},
								"deletions": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								},
								"diff": {
									"type": "string",
									"enum": [
										"included",
										"sealed-secret",
										"sealed-path",
										"binary",
										"too-large",
										"omitted"
									]
								}
							},
							"required": ["path", "status", "diff"],
							"additionalProperties": false
						}
					},
					"changesTruncated": {
						"type": "boolean",
						"const": true
					},
					"diffFile": {
						"type": "string",
						"pattern": "^history\\/commits\\/[0-9a-f]{40}\\.json$"
					}
				},
				"required": ["oid", "parents", "author", "time", "message", "changes"],
				"additionalProperties": false
			}
		},
		"branches": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 255
					},
					"head": {
						"type": "string",
						"pattern": "^[0-9a-f]{40}$"
					},
					"current": {
						"type": "boolean"
					},
					"remote": {
						"type": "boolean"
					},
					"commits": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[0-9a-f]{40}$"
						}
					},
					"truncated": {
						"type": "boolean"
					},
					"universe": {
						"type": "object",
						"properties": {
							"slug": {
								"type": "string",
								"pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
							},
							"worldUrl": {
								"type": "string",
								"pattern": "^universes\\/[a-z0-9][a-z0-9-]{0,79}\\/world\\.json$"
							}
						},
						"required": ["slug", "worldUrl"],
						"additionalProperties": false
					},
					"universeSkipped": {
						"type": "string",
						"enum": ["cap", "over-budget", "failed"]
					}
				},
				"required": [
					"name",
					"head",
					"current",
					"remote",
					"commits",
					"truncated"
				],
				"additionalProperties": false
			}
		},
		"tags": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 255
					},
					"oid": {
						"type": "string",
						"pattern": "^[0-9a-f]{40}$"
					},
					"annotated": {
						"type": "boolean"
					},
					"message": {
						"type": "string",
						"maxLength": 4000
					},
					"messageWithheld": {
						"type": "boolean",
						"const": true
					},
					"tagger": {
						"type": "string",
						"maxLength": 200
					},
					"time": {
						"type": "integer",
						"minimum": -9007199254740991,
						"maximum": 9007199254740991
					}
				},
				"required": ["name", "oid", "annotated"],
				"additionalProperties": false
			}
		},
		"releases": {
			"type": "object",
			"properties": {
				"source": {
					"type": "string",
					"enum": ["github", "none", "offline", "unavailable"]
				},
				"repo": {
					"type": "object",
					"properties": {
						"owner": {
							"type": "string",
							"maxLength": 100
						},
						"name": {
							"type": "string",
							"maxLength": 100
						},
						"url": {
							"type": "string",
							"maxLength": 2048
						}
					},
					"required": ["owner", "name", "url"],
					"additionalProperties": false
				},
				"items": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"tagName": {
								"type": "string",
								"minLength": 1,
								"maxLength": 255
							},
							"name": {
								"type": "string",
								"maxLength": 255
							},
							"body": {
								"type": "string",
								"maxLength": 20000
							},
							"prerelease": {
								"type": "boolean"
							},
							"publishedAt": {
								"anyOf": [
									{
										"type": "string",
										"maxLength": 40
									},
									{
										"type": "null"
									}
								]
							},
							"url": {
								"type": "string",
								"maxLength": 2048
							},
							"assets": {
								"maxItems": 50,
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"name": {
											"type": "string",
											"minLength": 1,
											"maxLength": 255
										},
										"size": {
											"type": "integer",
											"minimum": 0,
											"maximum": 9007199254740991
										},
										"downloadCount": {
											"type": "integer",
											"minimum": 0,
											"maximum": 9007199254740991
										},
										"url": {
											"type": "string",
											"maxLength": 2048
										}
									},
									"required": ["name", "size", "downloadCount", "url"],
									"additionalProperties": false
								}
							}
						},
						"required": [
							"tagName",
							"name",
							"body",
							"prerelease",
							"publishedAt",
							"url",
							"assets"
						],
						"additionalProperties": false
					}
				},
				"packages": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string",
								"minLength": 1,
								"maxLength": 255
							},
							"packageType": {
								"type": "string",
								"maxLength": 40
							},
							"url": {
								"type": "string",
								"maxLength": 2048
							}
						},
						"required": ["name", "packageType", "url"],
						"additionalProperties": false
					}
				}
			},
			"required": ["source", "items", "packages"],
			"additionalProperties": false
		},
		"dirtyPaths": {
			"type": "array",
			"items": {
				"type": "string",
				"maxLength": 1024
			}
		},
		"truncated": {
			"type": "object",
			"properties": {
				"branches": {
					"type": "boolean"
				},
				"tags": {
					"type": "boolean"
				},
				"omittedDiffs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": ["branches", "tags", "omittedDiffs"],
			"additionalProperties": false
		}
	},
	"required": [
		"historyVersion",
		"head",
		"commits",
		"branches",
		"tags",
		"releases",
		"dirtyPaths",
		"truncated"
	],
	"additionalProperties": false
}
