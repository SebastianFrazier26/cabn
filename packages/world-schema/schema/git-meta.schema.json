{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"gitVersion": {
			"type": "number",
			"const": 1
		},
		"head": {
			"type": "object",
			"properties": {
				"branch": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 255
						},
						{
							"type": "null"
						}
					]
				},
				"oid": {
					"type": "string",
					"pattern": "^[0-9a-f]{40}$"
				}
			},
			"required": ["branch", "oid"],
			"additionalProperties": false
		},
		"branches": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 255
					},
					"ref": {
						"type": "string",
						"minLength": 1,
						"maxLength": 300
					},
					"head": {
						"type": "string",
						"pattern": "^[0-9a-f]{40}$"
					},
					"current": {
						"type": "boolean"
					},
					"remote": {
						"type": "boolean"
					},
					"commits": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"truncated": {
						"type": "boolean"
					},
					"subject": {
						"type": "string",
						"maxLength": 500
					},
					"author": {
						"type": "string",
						"maxLength": 200
					},
					"time": {
						"type": "integer",
						"minimum": -9007199254740991,
						"maximum": 9007199254740991
					}
				},
				"required": [
					"name",
					"ref",
					"head",
					"current",
					"remote",
					"commits",
					"truncated",
					"subject",
					"author",
					"time"
				],
				"additionalProperties": false
			}
		},
		"tags": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 255
					},
					"oid": {
						"type": "string",
						"pattern": "^[0-9a-f]{40}$"
					},
					"annotated": {
						"type": "boolean"
					},
					"message": {
						"type": "string",
						"maxLength": 4000
					},
					"tagger": {
						"type": "string",
						"maxLength": 200
					},
					"time": {
						"type": "integer",
						"minimum": -9007199254740991,
						"maximum": 9007199254740991
					}
				},
				"required": ["name", "oid", "annotated"],
				"additionalProperties": false
			}
		},
		"pack": {
			"type": "object",
			"properties": {
				"bytes": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"objects": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"commitsPerBranch": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"halvings": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": ["bytes", "objects", "commitsPerBranch", "halvings"],
			"additionalProperties": false
		},
		"omitted": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[0-9a-f]{40}$"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"reason": {
						"type": "string",
						"enum": ["secret-name", "too-large", "ignored", "pack-cap"]
					},
					"size": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					}
				},
				"required": ["reason", "size"],
				"additionalProperties": false
			}
		},
		"truncated": {
			"type": "object",
			"properties": {
				"branches": {
					"type": "boolean"
				},
				"tags": {
					"type": "boolean"
				}
			},
			"required": ["branches", "tags"],
			"additionalProperties": false
		}
	},
	"required": [
		"gitVersion",
		"head",
		"branches",
		"tags",
		"pack",
		"omitted",
		"truncated"
	],
	"additionalProperties": false
}
