{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"monstersVersion": {
			"type": "number",
			"const": 1
		},
		"monsters": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"portalId": {
						"type": "string"
					},
					"pathId": {
						"type": "string"
					},
					"species": {
						"type": "string",
						"enum": [
							"ghost",
							"rot-sprite",
							"warded-mimic",
							"gremlin",
							"ouroboros",
							"will-o-wisp",
							"imp",
							"magpie",
							"skeleton",
							"bramble",
							"shade"
						]
					},
					"error": {
						"type": "object",
						"properties": {
							"code": {
								"type": "string",
								"enum": [
									"NullTypeError",
									"Corrupted",
									"InvalidMode",
									"IoError",
									"OuroborosError",
									"WispNote",
									"SyntaxError",
									"LeakedSecret",
									"DeadCode",
									"CodeSmell",
									"UnknownBug"
								]
							},
							"rule": {
								"type": "string"
							},
							"message": {
								"type": "string"
							},
							"loc": {
								"type": "object",
								"properties": {
									"line": {
										"type": "integer",
										"minimum": 0,
										"maximum": 9007199254740991
									},
									"col": {
										"type": "integer",
										"minimum": 0,
										"maximum": 9007199254740991
									}
								},
								"required": ["line", "col"],
								"additionalProperties": false
							}
						},
						"required": ["code", "rule", "message"],
						"additionalProperties": false
					},
					"tier": {
						"type": "integer",
						"minimum": 0,
						"maximum": 3
					}
				},
				"required": ["id", "species", "error", "tier"],
				"additionalProperties": false
			}
		},
		"findings": {
			"type": "object",
			"properties": {
				"ingested": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"attached": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"dropped": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": ["ingested", "attached", "dropped"],
			"additionalProperties": false
		}
	},
	"required": ["monstersVersion", "monsters"],
	"additionalProperties": false
}
