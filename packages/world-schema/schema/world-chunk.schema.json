{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"clusterId": {
			"type": "string"
		},
		"files": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"content": {
						"type": "string"
					},
					"encoding": {
						"type": "string",
						"const": "utf8"
					}
				},
				"required": ["content", "encoding"],
				"additionalProperties": false
			}
		}
	},
	"required": ["clusterId", "files"],
	"additionalProperties": false
}
