{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"cabnVersion": {
			"type": "number",
			"const": 1
		},
		"meta": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"source": {
					"type": "string"
				},
				"generatedAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				},
				"fileCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"totalBytes": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"truncated": {
					"type": "boolean"
				},
				"skippedFiles": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"themeSeed": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"name",
				"source",
				"generatedAt",
				"fileCount",
				"totalBytes",
				"truncated",
				"skippedFiles"
			],
			"additionalProperties": false
		},
		"clusters": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"path": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"pos": {
						"type": "object",
						"properties": {
							"x": {
								"type": "number"
							},
							"y": {
								"type": "number"
							}
						},
						"required": ["x", "y"],
						"additionalProperties": false
					},
					"biome": {
						"type": "string",
						"enum": ["meadow", "grove", "glade"]
					},
					"portalIds": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"chunk": {
						"type": "string"
					},
					"annexOf": {
						"type": "string"
					}
				},
				"required": [
					"id",
					"path",
					"label",
					"pos",
					"biome",
					"portalIds",
					"chunk"
				],
				"additionalProperties": false
			}
		},
		"paths": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"from": {
						"type": "string"
					},
					"to": {
						"type": "string"
					},
					"kind": {
						"type": "string",
						"enum": ["trail", "vine"]
					}
				},
				"required": ["from", "to", "kind"],
				"additionalProperties": false
			}
		},
		"portals": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"clusterId": {
						"type": "string"
					},
					"file": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"kind": {
								"type": "string",
								"enum": [
									"code",
									"markdown",
									"config",
									"data",
									"image",
									"binary",
									"unknown"
								]
							},
							"language": {
								"type": "string"
							},
							"bytes": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"lines": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"binary": {
								"type": "boolean"
							}
						},
						"required": ["path", "name", "kind", "bytes", "binary"],
						"additionalProperties": false
					},
					"preview": {
						"type": "object",
						"properties": {
							"lines": {
								"maxItems": 12,
								"type": "array",
								"items": {
									"type": "string",
									"maxLength": 120
								}
							},
							"truncated": {
								"type": "boolean"
							}
						},
						"required": ["lines", "truncated"],
						"additionalProperties": false
					},
					"spawns": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				},
				"required": ["id", "clusterId", "file", "preview", "spawns"],
				"additionalProperties": false
			}
		},
		"monsters": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"portalId": {
						"type": "string"
					},
					"pathId": {
						"type": "string"
					},
					"species": {
						"type": "string",
						"enum": [
							"ghost",
							"rot-sprite",
							"warded-mimic",
							"gremlin",
							"ouroboros",
							"will-o-wisp"
						]
					},
					"error": {
						"type": "object",
						"properties": {
							"code": {
								"type": "string",
								"enum": [
									"NullTypeError",
									"Corrupted",
									"InvalidMode",
									"IoError",
									"OuroborosError",
									"WispNote"
								]
							},
							"rule": {
								"type": "string"
							},
							"message": {
								"type": "string"
							},
							"loc": {
								"type": "object",
								"properties": {
									"line": {
										"type": "integer",
										"minimum": 0,
										"maximum": 9007199254740991
									},
									"col": {
										"type": "integer",
										"minimum": 0,
										"maximum": 9007199254740991
									}
								},
								"required": ["line", "col"],
								"additionalProperties": false
							}
						},
						"required": ["code", "rule", "message"],
						"additionalProperties": false
					},
					"tier": {
						"type": "integer",
						"minimum": 0,
						"maximum": 3
					}
				},
				"required": ["id", "species", "error", "tier"],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"cabnVersion",
		"meta",
		"clusters",
		"paths",
		"portals",
		"monsters"
	],
	"additionalProperties": false
}
