{
	"name": "@cabn/cli",
	"version": "0.1.0",
	"description": "The cabn CLI: build/inspect a world bundle, build a shelf of worlds, and cabn serve for a local walkable game with optional real code execution.",
	"keywords": [
		"cabn",
		"cli"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SebastianFrazier26/cabn.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/SebastianFrazier26/cabn/tree/main/packages/cli#readme",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"cabn": "dist/main.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
		"test": "vitest run"
	},
	"dependencies": {
		"@cabn/converter": "workspace:*",
		"@cabn/engine": "workspace:*",
		"@cabn/world-schema": "workspace:*",
		"esbuild": "^0.27.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^22.20.4"
	}
}
